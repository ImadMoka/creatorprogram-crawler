OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_SLIDES=20

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

CREATOR_DB_PATH=creatorprogram.sqlite

TIKTOK_SCRAPER_BASE_URL=
TIKTOK_SCRAPER_MAX_FOLLOWING_PAGES=10
# Optional. Passed through as region=<value> on scraper requests when set.
# TIKTOK_SCRAPER_REGION=US
TIKTOK_SCRAPER_TIMEOUT_SECONDS=60

# Reserved for the Instagram/TikTok adapters we will configure with our own provider.
INSTAGRAM_API_KEY=
TIKTOK_API_KEY=

# Optional local development mode. If this is set, the crawler reads either
# this exact JSON file or <directory>/<handle>.json instead of calling the scraper.
# TIKTOK_SCRAPER_FIXTURE_PATH=fixtures/tiktok
